  "agents": {
    "claude": {
      "description": "Claude Code, signed in with a Claude subscription. The token comes from `claude setup-token` and lives in .env as CLAUDE_CODE_OAUTH_TOKEN. Model and effort are the CLI's own defaults (the owner chose defaults), so boxSettings is empty on purpose.",
      "auth": [
        {
          "secret": "CLAUDE_CODE_OAUTH_TOKEN",
          "env": "CLAUDE_CODE_OAUTH_TOKEN"
        }
      ],
      "boxSettings": [],
      "command": "claude -p \"$(cat {prompt})\" --dangerously-skip-permissions --output-format text > {summary}"
    },
    "opencode": {
      "description": "OpenCode on the free OpenCode Zen tier. The CLI is not in the stock Box, so worker/setup.sh installs it into the image. UNVERIFIED until the smoke test: whether Zen needs a credential at all. The auth block below copies a local `opencode auth login` into the Box the way Codex does; if the smoke test shows Zen works with no credential, delete this block rather than leave a secret that does nothing.",
      "auth": [
        {
          "secret": "OPENCODE_AUTH_JSON",
          "file": "/home/boxuser/.local/share/opencode/auth.json",
          "localFile": "~/.local/share/opencode/auth.json"
        }
      ],
      "boxSettings": [
        {
          "path": "/home/boxuser/.config/opencode/opencode.json",
          "format": "json",
          "values": {
            "autoupdate": false,
            "share": "disabled"
          }
        }
      ],
      "promptExtra": "When you are done, write your summary to the file {summary}, and nothing else to that file.",
      "command": "opencode run \"$(cat {prompt})\""
    }
  },

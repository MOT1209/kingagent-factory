# From the Upstash console, Box section.
UPSTASH_BOX_API_KEY=

# Fine-grained GitHub token. Repository access: the factory repo and every app
# repo. Permissions: Contents, Pull requests and Issues, all read and write.
FACTORY_GITHUB_TOKEN=

# One line per agent sign-in secret named under "auth" in factory.config.json.
# Subscription or API key, whatever that agent type uses. For this factory:
#
#   CLAUDE_CODE_OAUTH_TOKEN   claude setup-token, run by you in a real terminal
#   OPENCODE_AUTH_JSON       the whole file `opencode auth login` writes, as one line
#
# OPENCODE_AUTH_JSON is file contents, so quote it:
# OPENCODE_AUTH_JSON='{"...":"..."}'
CLAUDE_CODE_OAUTH_TOKEN=
OPENCODE_AUTH_JSON=
